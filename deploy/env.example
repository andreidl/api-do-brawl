# Referência do arquivo de segredos da VM: /etc/apidobrawl.env
# (root:root, chmod 600, FORA do git). O setup.sh cria um esqueleto vazio.
# Formato systemd EnvironmentFile: KEY=VALOR, um por linha, SEM aspas e SEM export.
#
# Token da API oficial — com o IP PÚBLICO da VM registrado na key (Supercell):
BRAWL_API_TOKEN=

# Postgres do Supabase (mesma DATABASE_URL usada na Fase 2):
DATABASE_URL=

# Na VM o rastreador roda por systemd timer — desliga a thread embutida do app:
BRAWL_RASTREIO=0
